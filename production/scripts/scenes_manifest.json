  "text_overlays": [
    {"text": "I'm doing fine.", "start": 4.0, "end": 7.5},
    {"text": "I'm a good person.", "start": 8.0, "end": 11.5},
    {"text": "I don't hurt anyone.", "start": 12.0, "end": 15.5},
    {"text": "I'm not like those people.", "start": 16.0, "end": 19.5},

    {"text": "Maybe I need more.", "start": 44.0, "end": 49.0},
    {"text": "Maybe I need to be accepted.", "start": 60.0, "end": 65.0},
    {"text": "Maybe I just need a distraction.", "start": 74.0, "end": 79.0},
    {"text": "Maybe then I'll feel complete.", "start": 88.0, "end": 93.0},

    {"text": "Sometimes, we look away.", "start": 112.0, "end": 117.0},
    {"text": "We see what's wrong with others.", "start": 122.0, "end": 126.0},
    {"text": "But what about us?", "start": 126.5, "end": 130.0},
    {"text": "Our excuses.", "start": 145.0, "end": 148.0},
    {"text": "Our selfishness.", "start": 148.5, "end": 151.5},
    {"text": "Our hidden moments.", "start": 152.0, "end": 155.0},
    {"text": "Not just them.", "start": 159.0, "end": 161.0},
    {"text": "Not just those people.", "start": 161.2, "end": 163.2},
    {"text": "All of us.", "start": 163.4, "end": 165.0},

    {"text": "We kept searching.", "start": 171.0, "end": 175.0},
    {"text": "In everything.", "start": 175.5, "end": 179.5},
    {"text": "But what if we were missing Someone?", "start": 183.0, "end": 189.0},

    {"text": "Love came looking for us.", "start": 192.0, "end": 198.0},
    {"text": "Jesus.", "start": 202.0, "end": 207.0},
    {"text": "Born for us.", "start": 210.0, "end": 218.0},
    {"text": "LOVE CAME DOWN.", "start": 221.0, "end": 225.0},
    {"text": "JESUS", "start": 225.5, "end": 228.0}
  ]
